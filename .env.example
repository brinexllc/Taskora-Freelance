DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
DATABASE_SSL_REQUIRE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOW_ALL_ORIGINS=false
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_SECURE_SSL_REDIRECT=false
DEFAULT_FROM_EMAIL=noreply@taskora.uz
# In development password-reset codes are printed to the Django console.
# Configure these values in Railway for real email delivery.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# CLICK Shop API: configure these only after receiving merchant access.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
# Enable only the fiscal scheme agreed with CLICK for wallet deposits.
# Disabling fiscalization is allowed only when CLICK handles it separately.
CLICK_FISCALIZATION_ENABLED=true
# Approved service name including its unit (max 63 characters); no invented tax codes.
CLICK_FISCAL_ITEM_NAME=
CLICK_FISCAL_SPIC=
CLICK_FISCAL_PACKAGE_CODE=
# VAT included in the payment total; explicitly use 0 if applicable.
CLICK_FISCAL_VAT_PERCENT=
# Exactly one: TIN (9 digits) or PINFL (14 digits) for CommissionInfo.
CLICK_FISCAL_TIN=
CLICK_FISCAL_PINFL=
FRONTEND_URL=http://localhost:3000
# Eskiz SMS: approved message template and API token are required.
ESKIZ_TOKEN=
ESKIZ_SENDER=4546
# Use a persistent private disk in production. Never expose it as MEDIA_URL.
PRIVATE_MEDIA_ROOT=

# Payme Merchant API. order_id account field must be configured in the cashbox.
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_TEST_MODE=true
# Percentage charged to the freelancer; copied into each new contract.
# Safe fallback is 0. The owner explicitly enables 5 for NEW contracts at launch.
# Set PLATFORM_FEE_PERCENT=5, and later 8 only after a separately announced decision.
# Existing contracts retain their stored rate, including 0. Never use 0.05 or 5%.
PLATFORM_FEE_PERCENT=0
